# 예시 파일이다. 복사해 .env를 만들고 값을 바꾼다(.env는 커밋 금지, .gitignore에 있음).
#   cp .env.example .env && chmod 600 .env
# compose.prod.yaml은 docker compose --env-file .env 로 이 값을 읽는다.
# 로컬 실행(./gradlew bootRun)에서 Spring에 전달하려면 shell export로 명시적으로 로드한다.

# 공통
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
COMPOSE_PROJECT_NAME=resume-review

# 운영(prod 프로필) PostgreSQL. 비밀번호는 반드시 바꾼다.
POSTGRES_DB=resume_review
POSTGRES_USER=resume_review
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# 관리 포트(actuator: health·prometheus). 내부 전용
MANAGEMENT_PORT=18081

# API 문서(Swagger UI, /v3/api-docs). prod 기본 끔
API_DOCS_ENABLED=false

# IP별 분당 요청 한도(단일 인스턴스 기준)
RATE_LIMIT_USERS_PER_MIN=10
RATE_LIMIT_UPLOADS_PER_MIN=20

# 배포할 앱 이미지 태그(롤백 시 이전 태그로 바꾼다)
APP_IMAGE=resume-review:prod

# compose.prod.yaml 내부 네트워크. 겹치면 바꾸고 세 값을 맞춘다.
#APP_SUBNET=172.30.0.0/24
#APP_GATEWAY=172.30.0.1
#TRUSTED_PROXIES=172\.30\.0\.1
